# Frontend en Vercel (debe terminar en /api)
BOUTIQUE_API_URL=https://boutique-os-backend-trzm.onrender.com/api

# Backend en Render + Supabase Postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://db.xxx.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=tu-password
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_H2_CONSOLE_ENABLED=false
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,https://app.boutiqueos.dpdns.org,https://boutiqueos.dpdns.org

# Sesiones JWT (clave de al menos 32 caracteres; sin ella se genera una aleatoria
# y las sesiones se invalidan al reiniciar el backend)
APP_JWT_SECRET=cambia-esta-clave-por-una-secreta-larga-de-al-menos-32-caracteres
APP_JWT_TTL_HOURS=12

# Stripe (onboarding por suscripcion)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_CHECKOUT_MODE=subscription

# Frontend y correo
APP_FRONTEND_URL=https://app.boutiqueos.dpdns.org
APP_MAIL_FROM=boutiqueos@tudominio.com
APP_PASSWORD_RESET_TTL_MINUTES=20
